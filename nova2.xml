<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dobot Nova2 Phase 1 MuJoCo model.

  Kinematics are converted from the pinned official ROS2 V4 description at
  DOBOT_6Axis_ROS2_V4/cra_description/urdf/nova2_robot.xacro,
  revision 0f21e9839888f188ac06b0a9fea622d13a29a74f.

  Visual meshes are the official STL files. Collision geoms are mesh-bound
  box proxies generated from those same files; their dimensions are not
  dynamics parameters and are intentionally not tuned in Phase 1.
-->
<mujoco model="dobot_nova2">
  <compiler angle="radian" autolimits="true" meshdir="assets"/>
  <option gravity="0 0 0"/>
  <visual>
    <global offwidth="640" offheight="640"/>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.75 0.75 0.75"
               specular="0.2 0.2 0.2"/>
  </visual>

  <default>
    <joint type="hinge" damping="0" armature="0"/>
    <geom contype="1" conaffinity="1" density="1000"/>
  </default>

  <asset>
    <mesh name="base_link_mesh" file="base_link.STL"/>
    <mesh name="link1_mesh" file="Link1.STL"/>
    <mesh name="link2_mesh" file="Link2.STL"/>
    <mesh name="link3_mesh" file="Link3.STL"/>
    <mesh name="link4_mesh" file="Link4.STL"/>
    <mesh name="link5_mesh" file="Link5.STL"/>
    <mesh name="link6_mesh" file="Link6.STL"/>
    <material name="nova_gray" rgba="0.7921569 0.8196078 0.9333333 1"/>
  </asset>

  <worldbody>
    <light name="inspection_light" pos="1 -1 2" dir="-1 1 -2"
           directional="true" diffuse="0.7 0.7 0.7" specular="0.15 0.15 0.15"/>
    <!-- URDF world_joint: world -> dummy_link, xyz=(0,0,0.03). -->
    <body name="dummy_link" pos="0 0 0.03">
      <!-- URDF dummy_joint: dummy_link -> base_link, identity. -->
      <body name="base_link">
        <geom name="base_link_visual" type="mesh" mesh="base_link_mesh"
              material="nova_gray" contype="0" conaffinity="0" group="2"/>
        <!-- Bounds: center=(0, -0.0000002, 0.0673975), half=(0.06, 0.06, 0.0674028). -->
        <geom name="base_link_collision" type="box" pos="0 0 0.0673975"
              size="0.06 0.06 0.0674028" group="1"/>

        <!-- joint1: base_link -> Link1, URDF origin=(0,0,0.2234), axis=+Z. -->
        <body name="Link1" pos="0 0 0.2234">
          <joint name="joint1" axis="0 0 1" range="-6.28 6.28"/>
          <geom name="Link1_visual" type="mesh" mesh="link1_mesh"
                material="nova_gray" contype="0" conaffinity="0" group="2"/>
          <!-- Bounds-derived proxy: center=(-0.00000005,-0.0164795,-0.0217965). -->
          <geom name="Link1_collision" type="box" pos="-0.00000005 -0.0164795 -0.0217965"
                size="0.0444859 0.0611205 0.0663035" group="1"/>

          <!-- joint2: Link1 -> Link2, URDF origin rpy=(pi/2,pi/2,0), axis=+Z. -->
          <!-- quat is wxyz for Rz(yaw)*Ry(pitch)*Rx(roll). -->
          <body name="Link2" pos="0 0 0" quat="0.49999816 0.5 0.5 -0.50000184">
            <joint name="joint2" axis="0 0 1" range="-3.14 3.14"/>
            <geom name="Link2_visual" type="mesh" mesh="link2_mesh"
                  material="nova_gray" contype="0" conaffinity="0" group="2"/>
            <!-- Bounds-derived proxy: center=(-0.1379234,0,0.0892484). -->
            <geom name="Link2_collision" type="box" pos="-0.1379234 0 0.0892484"
                  size="0.1833415 0.0449987 0.0647483" group="1"/>

            <!-- joint3: Link2 -> Link3, origin=(-0.28,0,0), axis=+Z. -->
            <body name="Link3" pos="-0.28 0 0">
              <joint name="joint3" axis="0 0 1" range="-2.79 2.79"/>
              <geom name="Link3_visual" type="mesh" mesh="link3_mesh"
                    material="nova_gray" contype="0" conaffinity="0" group="2"/>
              <!-- Bounds-derived proxy: center=(-0.1100069,0,0.0159088). -->
              <geom name="Link3_collision" type="box" pos="-0.1100069 0 0.0159088"
                    size="0.1508677 0.04099997 0.0585913" group="1"/>

              <!-- joint4: Link3 -> Link4, rpy=(0,0,-pi/2), axis=+Z. -->
              <body name="Link4" pos="-0.22501 0 0.1175"
                    quat="0.70710548 0 0 -0.70710808">
                <joint name="joint4" axis="0 0 1" range="-6.28 6.28"/>
                <geom name="Link4_visual" type="mesh" mesh="link4_mesh"
                      material="nova_gray" contype="0" conaffinity="0" group="2"/>
                <!-- Bounds-derived proxy: center=(-0.0000004,-0.0207461,-0.0182461). -->
                <geom name="Link4_collision" type="box" pos="-0.0000004 -0.0207461 -0.0182461"
                      size="0.0355001 0.05575 0.0532499" group="1"/>

                <!-- joint5: Link4 -> Link5, rpy=(pi/2,0,0), axis=+Z. -->
                <body name="Link5" pos="0 -0.12 0"
                      quat="0.70710548 0.70710808 0 0">
                  <joint name="joint5" axis="0 0 1" range="-6.28 6.28"/>
                  <geom name="Link5_visual" type="mesh" mesh="link5_mesh"
                        material="nova_gray" contype="0" conaffinity="0" group="2"/>
                  <!-- Bounds-derived proxy: center=(0.0000003,0.0013631,-0.0103160). -->
                  <geom name="Link5_collision" type="box" pos="0.0000003 0.0013631 -0.0103160"
                        size="0.0357698 0.0631409 0.0456893" group="1"/>

                  <!-- joint6: Link5 -> Link6, rpy=(-pi/2,0,0), axis=+Z. -->
                  <body name="Link6" pos="0 0.088004 0"
                        quat="0.70710548 -0.70710808 0 0">
                    <joint name="joint6" axis="0 0 1" range="-6.28 6.28"/>
                    <geom name="Link6_visual" type="mesh" mesh="link6_mesh"
                          material="nova_gray" contype="0" conaffinity="0" group="2"/>
                    <!-- Bounds-derived proxy: center=(-0.0000005,-0.0000000,-0.0180000). -->
                    <geom name="Link6_collision" type="box" pos="-0.0000005 0 -0.018"
                          size="0.035 0.035 0.018" group="1"/>
                    <!-- Official description has no separate TCP/tool link. -->
                    <site name="tcp" type="sphere" pos="0 0 0" size="0.004"
                          rgba="0.9 0.1 0.1 1"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
